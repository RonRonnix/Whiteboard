generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  pending
  active
}

enum RoomRole {
  owner
  editor
  viewer
}

model User {
  id              String              @id @default(cuid())
  email           String              @unique
  passwordHash    String
  displayName     String
  status          UserStatus          @default(pending)
  emailVerifiedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdRooms    SessionRoom[]       @relation("RoomCreator")
  roomMemberships SessionRoomMember[]
  verifications   EmailVerification[]
  whiteboardStrokes WhiteboardStroke[]
  roomMessages    RoomMessage[]
}

model SessionRoom {
  id          String   @id @default(cuid())
  title       String
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  createdById String
  inviteExpiresAt DateTime?
  inviteRevokedAt DateTime?

  createdBy User              @relation("RoomCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   SessionRoomMember[]
  board     WhiteboardDocument?
  messages  RoomMessage[]
  strokes   WhiteboardStroke[]

  @@index([createdById])
}

model WhiteboardDocument {
  roomId    String   @id
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room      SessionRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  snapshots WhiteboardSnapshot[]
}

model WhiteboardStroke {
  id                String   @id @default(cuid())
  roomId            String
  userId            String
  clientId          String
  boardVersion      Int
  color             String
  size              Float
  tool              String   @default("pen")
  points            Json
  createdAt         DateTime @default(now())
  undoneAt          DateTime?
  redoInvalidatedAt DateTime?

  room SessionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, clientId])
  @@index([roomId, boardVersion, createdAt])
  @@index([roomId, userId, undoneAt])
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  clientId  String
  content   String
  createdAt DateTime @default(now())

  room SessionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@unique([roomId, clientId])
}

model WhiteboardSnapshot {
  id             String   @id @default(cuid())
  roomId         String
  boardVersion   Int
  operationCount Int
  state          Json
  createdAt      DateTime @default(now())

  document WhiteboardDocument @relation(fields: [roomId], references: [roomId], onDelete: Cascade)

  @@index([roomId, boardVersion, createdAt])
}

model SessionRoomMember {
  roomId   String
  userId   String
  role     RoomRole @default(viewer)
  joinedAt DateTime @default(now())

  room SessionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model EmailVerification {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
